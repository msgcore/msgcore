# ==============================================================================
# MsgCore Docker Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your deployment
# ==============================================================================

# ==============================================================================
# Required Configuration
# ==============================================================================

# External PostgreSQL Database
# Format: postgresql://username:password@hostname:port/database?schema=public
# Examples:
#   - AWS RDS: postgresql://admin:password@msgcore.abc123.us-east-1.rds.amazonaws.com:5432/msgcore?schema=public
#   - DigitalOcean: postgresql://doadmin:password@msgcore-db-do-user-123.db.ondigitalocean.com:25060/msgcore?schema=public
#   - Local: postgresql://msgcore:msgcore_password@host.docker.internal:5432/msgcore?schema=public
DATABASE_URL=postgresql://username:password@hostname:5432/msgcore?schema=public

# External Redis
# Option 1: Full URL format (recommended)
REDIS_URL=redis://:password@hostname:6379

# Option 2: Individual components (alternative to REDIS_URL)
# REDIS_HOST=hostname
# REDIS_PORT=6379
# REDIS_PASSWORD=password

# Security Keys (REQUIRED - generate strong random values)
# JWT_SECRET: Minimum 32 characters
# ENCRYPTION_KEY: Exactly 64 hex characters (32 bytes)
# Generate with:
#   JWT_SECRET: openssl rand -hex 32
#   ENCRYPTION_KEY: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-required-here
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# API Configuration
# ==============================================================================

# Public URL where MsgCore will be accessible
# Examples:
#   - Production: https://msgcore.yourdomain.com
#   - Development: http://localhost:7890
MSGCORE_API_URL=http://localhost:7890

# Port mapping (host:container)
MSGCORE_PORT=7890

# CORS allowed origins (comma-separated)
# Examples:
#   - Development: *
#   - Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# ==============================================================================
# Optional: Auth0 Configuration (Enterprise SSO)
# ==============================================================================
# Uncomment and configure if using Auth0 authentication
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_AUDIENCE=https://api.msgcore.dev

# ==============================================================================
# Optional: Platform Credentials (Global Fallbacks)
# ==============================================================================
# Note: Platform credentials are typically configured per-project via API
# These are only used as fallback values if not configured per-project

# DISCORD_BOT_TOKEN=your-discord-bot-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ==============================================================================
# Advanced Configuration
# ==============================================================================

# Node environment
NODE_ENV=production

# Backend internal port (usually no need to change)
PORT=3000

# Database pool settings (optional)
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# Redis connection timeout (optional)
# REDIS_CONNECT_TIMEOUT=10000

# ==============================================================================
# Local Development with Embedded Databases
# ==============================================================================
# If you want to use the included PostgreSQL and Redis (docker-compose.yml):
#
# DATABASE_URL=postgresql://msgcore:msgcore_password@postgres:5432/msgcore?schema=public
# REDIS_URL=redis://:redis_password@redis:6379
# DB_USER=msgcore
# DB_PASSWORD=msgcore_password
# DB_NAME=msgcore
# DB_PORT=5432
# REDIS_PASSWORD=redis_password
# REDIS_PORT=6379
