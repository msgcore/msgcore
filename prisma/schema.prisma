generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(uuid())
  auth0Id               String?             @unique @map("auth0_id")
  email                 String              @unique
  name                  String?
  passwordHash          String?             @map("password_hash")
  isAdmin               Boolean             @default(false) @map("is_admin")
  subscriptionTier      SubscriptionTier    @default(FREE) @map("subscription_tier")
  subscriptionStatus    SubscriptionStatus  @default(ACTIVE) @map("subscription_status")
  stripeCustomerId      String?             @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?             @unique @map("stripe_subscription_id")
  subscriptionStartedAt DateTime?           @map("subscription_started_at")
  subscriptionEndsAt    DateTime?           @map("subscription_ends_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  apiKeysCreated        ApiKey[]            @relation("ApiKeyCreator")
  projectMembers        ProjectMember[]
  ownedProjects         Project[]
  messageUsage          MessageUsage[]

  @@index([stripeCustomerId])
  @@index([subscriptionTier])
  @@map("users")
}

model Project {
  id                 String               @id
  name               String
  description        String?
  environment        ProjectEnvironment   @default(development)
  status             ProjectStatus        @default(ACTIVE)
  isDefault          Boolean              @default(false) @map("is_default")
  settings           Json?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  ownerId            String               @map("owner_id")
  apiKeys            ApiKey[]
  blocked_messages   blocked_messages[]
  chats              Chat[]
  guardrail_policies guardrail_policies[]
  identities         Identity[]
  identityAliases    IdentityAlias[]
  invites            Invite[]
  platformLogs       PlatformLog[]
  members            ProjectMember[]
  projectPlatforms   ProjectPlatform[]
  owner              User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages           Message[]
  receivedReactions  ReceivedReaction[]
  webhooks           Webhook[]
  entitySchemas      EntitySchema[]
  analysisProfiles   AnalysisProfile[]
  analysisRuns       AnalysisRun[]
  extractedEntities  ExtractedEntity[]

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole @default(member)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Invite {
  id        String   @id @default(uuid())
  email     String
  projectId String   @map("project_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("invites")
}

model ApiKey {
  id         String        @id @default(uuid())
  projectId  String        @map("project_id")
  keyHash    String        @unique @map("key_hash")
  keyPrefix  String        @map("key_prefix")
  keySuffix  String        @map("key_suffix")
  name       String
  expiresAt  DateTime?     @map("expires_at")
  lastUsedAt DateTime?     @map("last_used_at")
  revokedAt  DateTime?     @map("revoked_at")
  createdBy  String?       @map("created_by")
  createdAt  DateTime      @default(now()) @map("created_at")
  scopes     ApiKeyScope[]
  usage      ApiKeyUsage[]
  creator    User?         @relation("ApiKeyCreator", fields: [createdBy], references: [id])
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([keyHash])
  @@index([createdBy])
  @@map("api_keys")
}

model ApiKeyScope {
  apiKeyId String @map("api_key_id")
  scope    String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, scope])
  @@map("api_key_scopes")
}

model ProjectPlatform {
  id                   String             @id
  projectId            String             @map("project_id")
  platform             String
  name                 String
  description          String?
  credentialsEncrypted String             @map("credentials_encrypted")
  webhookToken         String             @unique @default(uuid()) @map("webhook_token")
  isActive             Boolean            @default(true) @map("is_active")
  testMode             Boolean            @default(false) @map("test_mode")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  chats                Chat[]
  identityAliases      IdentityAlias[]
  platformLogs         PlatformLog[]
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages             Message[]
  receivedReactions    ReceivedReaction[]

  @@index([projectId])
  @@index([webhookToken])
  @@index([projectId, platform])
  @@index([projectId, name])
  @@map("project_platforms")
}

model ApiKeyUsage {
  id             String   @id @default(uuid())
  apiKeyId       String   @map("api_key_id")
  endpoint       String
  method         String
  statusCode     Int      @map("status_code")
  responseTimeMs Int      @map("response_time_ms")
  timestamp      DateTime @default(now())
  ipAddress      String   @map("ip_address")
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([timestamp])
  @@map("api_key_usage")
}

model Chat {
  id                String            @id @default(uuid())
  projectId         String            @map("project_id")
  platformId        String            @map("platform_id")
  providerChatId    String            @map("provider_chat_id")
  chatType          ChatType          @map("chat_type")
  name              String?
  avatarUrl         String?           @map("avatar_url")
  lastMessageAt     DateTime?         @map("last_message_at")
  lastSyncedAt      DateTime?         @map("last_synced_at")
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  messages          Message[]
  platformConfig    ProjectPlatform   @relation(fields: [platformId], references: [id], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  extractedEntities ExtractedEntity[]

  @@unique([projectId, platformId, providerChatId])
  @@index([projectId])
  @@index([platformId])
  @@index([lastMessageAt])
  @@index([chatType])
  @@map("chats")
}

model Message {
  id                String              @id @default(uuid())
  projectId         String              @map("project_id")
  platformId        String              @map("platform_id")
  chatId            String              @map("chat_id")
  direction         MessageDirection
  source            MessageSource
  providerMessageId String?             @map("provider_message_id")
  providerChatId    String              @map("provider_chat_id")
  providerUserId    String              @map("provider_user_id")
  userDisplay       String?             @map("user_display")
  messageText       String?             @map("message_text") @db.Text
  messageType       String              @default("text") @map("message_type")
  messageContent    Json?               @map("message_content")
  timestamp         DateTime            @default(now())
  jobId             String?             @unique @map("job_id")
  status            MessageStatus?
  errorMessage      String?             @map("error_message") @db.Text
  rawData           Json?               @map("raw_data")
  attachments       MessageAttachment[]
  reactions         ReceivedReaction[]
  chat              Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  platformConfig    ProjectPlatform     @relation(fields: [platformId], references: [id], onDelete: Cascade)
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([platformId, providerMessageId])
  @@index([chatId, timestamp(sort: Desc)])
  @@index([projectId, timestamp])
  @@index([platformId, timestamp])
  @@index([providerChatId])
  @@index([providerUserId])
  @@index([direction])
  @@index([source])
  @@index([status])
  @@index([jobId])
  @@map("messages")
}

model MessageAttachment {
  id        String  @id @default(uuid())
  messageId String  @map("message_id")
  type      String
  url       String
  filename  String?
  size      Int?
  mimeType  String? @map("mime_type")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([type])
  @@map("message_attachments")
}

model ReceivedReaction {
  id                String          @id @default(uuid())
  projectId         String          @map("project_id")
  platformId        String          @map("platform_id")
  messageId         String?         @map("message_id")
  providerMessageId String          @map("provider_message_id")
  providerChatId    String          @map("provider_chat_id")
  providerUserId    String          @map("provider_user_id")
  userDisplay       String?         @map("user_display")
  emoji             String          @db.VarChar(255)
  reactionType      ReactionType    @map("reaction_type")
  rawData           Json            @map("raw_data")
  timestamp         DateTime        @default(now())
  message           Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  platformConfig    ProjectPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([platformId, providerMessageId, providerUserId, emoji, reactionType])
  @@index([projectId])
  @@index([platformId])
  @@index([messageId])
  @@index([timestamp])
  @@index([providerChatId])
  @@index([providerUserId])
  @@index([providerMessageId])
  @@index([reactionType])
  @@index([platformId, providerUserId])
  @@map("received_reactions")
}

model PlatformLog {
  id             String           @id @default(uuid())
  projectId      String           @map("project_id")
  platformId     String?          @map("platform_id")
  platform       String
  level          String
  category       String
  message        String
  metadata       Json?
  error          String?
  timestamp      DateTime         @default(now())
  platformConfig ProjectPlatform? @relation(fields: [platformId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([platformId])
  @@index([timestamp])
  @@index([level])
  @@index([category])
  @@map("platform_logs")
}

model Webhook {
  id         String            @id @default(uuid())
  projectId  String            @map("project_id")
  name       String
  url        String
  events     String[]
  secret     String
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  deliveries WebhookDelivery[]
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, isActive])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String    @map("webhook_id")
  event        String
  payload      Json
  responseCode Int?      @map("response_code")
  responseBody String?   @map("response_body")
  error        String?
  attempts     Int       @default(0)
  status       String
  deliveredAt  DateTime? @map("delivered_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
  @@index([status])
  @@index([event])
  @@map("webhook_deliveries")
}

model Identity {
  id               String            @id @default(uuid())
  projectId        String            @map("project_id")
  displayName      String?           @map("display_name")
  email            String?
  metadata         Json?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aliases          IdentityAlias[]
  extractedEntities ExtractedEntity[]

  @@index([projectId])
  @@index([projectId, email])
  @@index([projectId, displayName])
  @@map("identities")
}

model IdentityAlias {
  id                  String             @id @default(uuid())
  identityId          String             @map("identity_id")
  projectId           String             @map("project_id")
  platformId          String             @map("platform_id")
  platform            String
  providerUserId      String             @map("provider_user_id")
  providerUserDisplay String?            @map("provider_user_display")
  linkedAt            DateTime           @default(now()) @map("linked_at")
  linkMethod          IdentityLinkMethod @default(manual) @map("link_method")
  identity            Identity           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  platformConfig      ProjectPlatform    @relation(fields: [platformId], references: [id], onDelete: Cascade)
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([platformId, providerUserId])
  @@index([identityId])
  @@index([projectId])
  @@index([providerUserId])
  @@index([platformId, providerUserId])
  @@map("identity_aliases")
}

model blocked_messages {
  id                 String             @id
  project_id         String
  platform_id        String?
  policy_id          String
  direction          String
  message_text       String
  violations         Json
  metadata           Json?
  blocked_at         DateTime           @default(now())
  guardrail_policies guardrail_policies @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  projects           Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([blocked_at])
  @@index([direction])
  @@index([policy_id])
  @@index([project_id])
}

model guardrail_policies {
  id               String             @id
  project_id       String
  name             String
  description      String?
  direction        String
  providers        Json
  strategy         String
  action           String
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now())
  updated_at       DateTime
  blocked_messages blocked_messages[]
  projects         Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([project_id, is_active])
}

enum ProjectEnvironment {
  production
  staging
  development
  custom
}

enum ProjectStatus {
  ACTIVE
  SUSPENDED
}

enum ProjectRole {
  owner
  admin
  member
  viewer
}

enum ReactionType {
  added
  removed
}

enum IdentityLinkMethod {
  manual
  automatic
}

enum ChatType {
  user
  group
  channel
}

enum MessageDirection {
  sent
  received
}

enum MessageSource {
  api
  phone
  webhook
}

enum MessageStatus {
  queued
  sent
  delivered
  failed
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  UNPAID
}

model EntitySchema {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  name            String
  description     String?

  extractionType  String   @map("extraction_type")
  properties      Json

  prompt          String?  @db.Text
  model           String?
  temperature     Float?

  ruleDefinition  Json?    @map("rule_definition")

  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entities        ExtractedEntity[]

  @@unique([projectId, name])
  @@index([projectId, isActive])
  @@map("entity_schemas")
}

model AnalysisProfile {
  id                String   @id @default(uuid())
  projectId         String   @map("project_id")
  name              String
  description       String?
  version           Int      @default(1)

  graphDefinition   Json     @map("graph_definition")
  entitySchemaIds   String[] @map("entity_schema_ids")

  triggerOnReceive  Boolean  @default(false) @map("trigger_on_receive")
  triggerOnSchedule String?  @map("trigger_on_schedule")
  triggerOnDemand   Boolean  @default(true) @map("trigger_on_demand")

  storeEntities     Boolean  @default(true) @map("store_entities")
  generateTags      Boolean  @default(false) @map("generate_tags")

  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs              AnalysisRun[]

  @@unique([projectId, name, version])
  @@index([projectId, isActive])
  @@map("analysis_profiles")
}

model AnalysisRun {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  profileId        String    @map("profile_id")
  profileVersion   Int       @map("profile_version")

  chatIds          String[]  @default([]) @map("chat_ids")
  identityIds      String[]  @default([]) @map("identity_ids")
  dateRangeStart   DateTime? @map("date_range_start")
  dateRangeEnd     DateTime? @map("date_range_end")

  status           String
  progress         Float     @default(0)

  entitiesExtracted Int      @default(0) @map("entities_extracted")
  errorMessage     String?   @db.Text @map("error_message")

  tokensUsed       Int?      @map("tokens_used")
  estimatedCostUsd Float?    @map("estimated_cost_usd")

  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  profile          AnalysisProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entities         ExtractedEntity[]

  @@index([projectId, status])
  @@index([profileId, createdAt])
  @@map("analysis_runs")
}

model ExtractedEntity {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  entitySchemaId   String   @map("entity_schema_id")
  runId            String   @map("run_id")
  profileVersion   Int      @map("profile_version")

  properties       Json

  identityId       String?  @map("identity_id")
  chatId           String?  @map("chat_id")
  sourceMessageIds String[] @map("source_message_ids")

  isLatest         Boolean  @default(true) @map("is_latest")
  confidence       Float?

  extractedAt      DateTime @default(now()) @map("extracted_at")

  entitySchema     EntitySchema @relation(fields: [entitySchemaId], references: [id], onDelete: Cascade)
  run              AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  identity         Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  chat             Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([projectId, entitySchemaId, isLatest])
  @@index([identityId, extractedAt])
  @@index([chatId, extractedAt])
  @@index([runId])
  @@map("extracted_entities")
}

model BaileysAuthState {
  id            String   @id @default(uuid())
  connectionKey String   @unique @map("connection_key") // "projectId:platformId"
  creds         String   // Encrypted auth credentials (JSON)
  keys          String   // Encrypted signal protocol keys (JSON)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([connectionKey])
  @@map("baileys_auth_states")
}

model MessageUsage {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  month           Int      // 1-12
  year            Int      // 2024, 2025, etc.
  messagesSent    Int      @default(0) @map("messages_sent")
  messagesReceived Int      @default(0) @map("messages_received")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@map("message_usage")
}
